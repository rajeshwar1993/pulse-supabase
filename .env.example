# Local Development Environment Variables
# Copy this file to .env.local and fill in the values after running 'supabase start'

# Supabase Local Instance
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# JWT Secret (from supabase start output)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
